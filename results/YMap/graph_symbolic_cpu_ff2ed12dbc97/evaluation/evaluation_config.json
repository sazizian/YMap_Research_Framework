{
  "mode": "research",
  "models": [
    "linear",
    "ridge",
    "random_forest",
    "extra_trees",
    "mlp",
    "neural"
  ],
  "ensemble_base": "neural",
  "ensemble_size": 5,
  "model_parameters": {
    "random_forest": {
      "n_estimators": 100
    },
    "extra_trees": {
      "n_estimators": 100
    },
    "mlp": {
      "hidden_layer_sizes": [
        64,
        32
      ],
      "max_iter": 500
    }
  },
  "seed": 42,
  "risk_lambda": 1.0,
  "calibration_alpha": 0.1,
  "weights": [
    0.3333333333,
    0.3333333333,
    0.3333333334
  ],
  "reference_model": "ensemble_risk",
  "calibration": true,
  "calibration_fraction": 0.25,
  "selection_mode": "pareto",
  "neural": {
    "device": "cpu",
    "text_encoders": [],
    "use_graph": true,
    "use_symbolic": true,
    "hidden_dim": 32,
    "graph_layers": 2,
    "epochs": 10,
    "batch_size": 16,
    "learning_rate": 0.001,
    "dropout": 0.1,
    "weight_decay": 0.0001,
    "deterministic": true,
    "target_names": [
      "insert_ms",
      "query_ms",
      "storage_mb"
    ]
  }
}