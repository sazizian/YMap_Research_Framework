{
  "domain": "large-enterprise",
  "classes": [
    {
      "name": "Party",
      "attributes": [
        {
          "name": "name",
          "type": "string"
        }
      ]
    },
    {
      "name": "Employee",
      "extends": "Party",
      "attributes": [
        {
          "name": "employee_no",
          "type": "string"
        }
      ]
    },
    {
      "name": "Vendor",
      "extends": "Party",
      "attributes": [
        {
          "name": "vendor_no",
          "type": "string"
        }
      ]
    },
    {
